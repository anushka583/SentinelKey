SENTINELKEY_ENVIRONMENT=development
SENTINELKEY_DATABASE_URL=sqlite:///./sentinelkey.db

# Local development JWT settings. Generate and set a private value locally;
# do not commit it. The development token issuer refuses secrets shorter than
# 32 characters and is disabled outside the development environment.
SENTINELKEY_AUTH_MODE=development
SENTINELKEY_JWT_ISSUER=sentinelkey-development
SENTINELKEY_JWT_AUDIENCE=sentinelkey-api
SENTINELKEY_JWT_SECRET=

# Deterministic monitoring rule thresholds and request limits.
SENTINELKEY_DETECTION_FAILED_AUTH_THRESHOLD=5
SENTINELKEY_DETECTION_FAILED_AUTH_WINDOW_SECONDS=600
SENTINELKEY_DETECTION_ACCESS_DENIED_THRESHOLD=5
SENTINELKEY_DETECTION_ACCESS_DENIED_WINDOW_SECONDS=600
SENTINELKEY_EVENT_METADATA_MAX_BYTES=16384

# For a future OIDC provider, set auth mode to oidc and configure its JWKS URL,
# issuer, and audience. OIDC tokens are restricted to RS256.
# SENTINELKEY_AUTH_MODE=oidc
# SENTINELKEY_OIDC_JWKS_URL=https://identity.example.test/realms/sentinelkey/protocol/openid-connect/certs
# SENTINELKEY_JWT_ISSUER=https://identity.example.test/realms/sentinelkey
# SENTINELKEY_JWT_AUDIENCE=sentinelkey-api